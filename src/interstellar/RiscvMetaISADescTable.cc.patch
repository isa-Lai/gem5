## Validation Script

**File:** `research-plan/scripts/diagnose_stream_matching.py`
```python
#!/usr/bin/env python3
"""
Diagnose stream matching failures by analyzing debug output
"""

import sys
import re
from pathlib import Path
from collections import defaultdict

def analyze_stream_matching(debug_file: Path):
    """Analyze stream matching debug output"""
    content = debug_file.read_text()

    # Extract TLB inverse entries
    tlb_entries = re.findall(r'TLB-1\[(.*?)\]=(.*?)[\n\r]', content)

    # Extract stream boundaries
    streams = re.findall(r'Stream\[(\d+)\]: baseVA=(\S+) endVA=(\S+)', content)

    # Extract matching attempts
    matches = re.findall(r'STREAM FOUND: descriptor (\d+)', content)
    failures = re.findall(r'NO STREAM MATCH: addr=(\S+)', content)

    print("=== STREAM MATCHING ANALYSIS ===\n")

    # TLB Inverse Analysis
    print(f"TLB Inverse Entries: {len(tlb_entries)}")
    if len(tlb_entries) < 3:
        print("  ⚠️  WARNING: Fewer than 3 TLB entries - stream addresses may not be covered")
    for pfn, vpn in tlb_entries:
        print(f"  TLB-1[{pfn}] = {vpn}")

    # Stream Analysis
    print(f"\nActive Streams: {len(streams)}")
    for stream_id, base, end in streams:
        print(f"  Stream[{stream_id}]: {base} → {end}")

    # Matching Results
    print(f"\nMatching Results:")
    print(f"  Successful matches: {len(matches)}")
    print(f"  Failed matches: {len(failures)}")

    if len(matches) == 0:
        print("\n❌ CRITICAL: No successful stream matches!")
        print("   This indicates TLB inverse does not cover stream addresses")
        print("   FIX NEEDED: Improve TLB inverse population strategy")
    else:
        success_rate = len(matches) / (len(matches) + len(failures))
        print(f"  Success rate: {success_rate:.1%}")
        if success_rate > 0.1:
            print("  ✅ Stream matching working")
        else:
            print("  ⚠️  Low success rate - investigation needed")

if __name__ == "__main__":
    debug_file = Path(sys.argv[1]) if len(sys.argv) > 1 else Path("/tmp/interstellar_test.txt")
    analyze_stream_matching(debug_file)
```

